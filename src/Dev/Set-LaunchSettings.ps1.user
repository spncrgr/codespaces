[CmdletBinding()]
param (
    [Parameter(Mandatory = $true)]
    [string]$Path
)

function Set-LaunchSettings {

    if (Test-Path $Path) {
        $settings = Get-Content -Path $Path | ConvertFrom-Json    
    }
    else {
        Write-Error "File not found: $Path"
        return -1
    }
    $settings.iisSettings.iisExpress.sslPort = 44328
    $settings | ConvertTo-Json -Depth 3 | Set-Content -Path $Path
}

Set-LaunchSettings
